# ===========================================
# Required: GCP Project Configuration
# ===========================================
GCP_DEFAULT_PROJECT=your-gcp-project-id

# ===========================================
# Optional: Limits
# ===========================================

# Maximum number of log entries per request (default: 1000)
LOGS_MAX_LIMIT=1000

# Maximum number of error groups per request (default: 100)
ERRORS_MAX_LIMIT=100

# ===========================================
# Optional: Shared HTTP server with OAuth (--auth google)
# ===========================================
# See README "Shared server on Cloud Run". Local dev example:
# MCP_TRANSPORT=http
# MCP_AUTH=google
# AUTH_ISSUER_URL=http://localhost:8080
# AUTH_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# AUTH_GOOGLE_CLIENT_SECRET=...
# AUTH_ALLOWED_DOMAINS=your-company.com
# Alternative gate for teams without a Workspace domain: require IAM access to a project
# AUTH_REQUIRE_PROJECT_ACCESS=your-observability-project
# AUTH_TOKEN_KEY=<output of: openssl rand -base64 32>
