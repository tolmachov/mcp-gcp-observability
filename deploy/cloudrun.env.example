# Non-secret runtime settings for the shared Cloud Run deployment.
# Copy to deploy/cloudrun.env and fill in; `make deploy` passes it via
# --env-vars-file. Secrets (AUTH_GOOGLE_CLIENT_SECRET, AUTH_TOKEN_KEY) are NOT
# set here — they come from Secret Manager via --set-secrets.
# Pin the server to one project (login then requires IAM access to it).
# OMIT this line entirely to let each user choose a project at login.
GCP_DEFAULT_PROJECT: your-observability-project
MCP_TRANSPORT: http
MCP_AUTH: google
# Public URL of the Cloud Run service (known after the first deploy).
AUTH_ISSUER_URL: https://mcp-gcp-observability-xxxxxxxxxx.a.run.app
# OAuth web client from the same GCP project (redirect URI: {AUTH_ISSUER_URL}/callback).
AUTH_GOOGLE_CLIENT_ID: 000000000000-xxxxxxxx.apps.googleusercontent.com
# Login gate: Workspace domain(s) and/or IAM access to a project (for teams
# on personal Google accounts). At least one must be set.
AUTH_ALLOWED_DOMAINS: your-company.com
# AUTH_REQUIRE_PROJECT_ACCESS: your-observability-project
