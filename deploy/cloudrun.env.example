# Non-secret settings. Copy to deploy/cloudrun.env. Secrets are injected from
# Secret Manager by deploy/rollout.sh and must never be placed in this file.
# Pinning removes project_id from every public tool/prompt/resource schema.
# Omit this line for an unpinned deployment; every project-scoped call then
# requires project_id and AUTH_ALLOWED_DOMAINS must be non-empty.
GCP_DEFAULT_PROJECT: your-observability-project
MCP_TRANSPORT: http
# Public load-balancer URL. A run.app URL is deliberately not supported here.
AUTH_ISSUER_URL: https://mcp-observability.example.com
# OAuth web client redirect URI must be {AUTH_ISSUER_URL}/callback.
AUTH_GOOGLE_CLIENT_ID: 000000000000-xxxxxxxx.apps.googleusercontent.com
# Firestore is security state only; GCP data calls always use the user token.
AUTH_STATE_PROJECT: your-runtime-project
AUTH_STATE_DATABASE: (default)
# Required for unpinned HTTP; recommended as an admission gate when pinned.
AUTH_ALLOWED_DOMAINS: your-company.com
